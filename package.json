{
  "name": "smella",
  "version": "0.1.0",
  "private": true,
  "description": "Explain JavaScript and TypeScript export usage by context",
  "type": "module",
  "bin": {
    "smella": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/nx-react.md"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "optionalDependencies": {
    "smella-linux-x64-gnu": "0.1.0"
  },
  "scripts": {
    "build:native": "bun scripts/build.mjs --release",
    "build:ts": "tsdown",
    "build:bin": "bun build lib/cli.ts --compile --bytecode --format=esm --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json --external smella-linux-x64-gnu --outfile bin/smella",
    "build": "bun scripts/build.mjs --release && tsdown && bun run build:bin",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "smella": "bun dist/cli.mjs --check --dependencies",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run smella",
    "test": "bun scripts/build.mjs && tsdown && bun test test/*.test.mjs",
    "bench": "bun run build && bun scripts/bench.mjs",
    "bench:workspace": "bun run build && bun scripts/bench-workspace.mjs",
    "bench:nx-react": "bun run build && bun scripts/bench-nx-react.mjs",
    "bench:record": "bun run build && bun scripts/track-bench.mjs --record --check",
    "verify:corpus": "bun run build && bun scripts/verify-corpus.mjs",
    "compare:test-usage": "bun run build && bun scripts/compare-test-usage.mjs",
    "bench:check": "bun run build && bun scripts/track-bench.mjs --check",
    "bench:plot": "bun scripts/plot-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
