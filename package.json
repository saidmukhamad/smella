{
  "name": "smella",
  "version": "0.1.0",
  "private": true,
  "description": "Explain JavaScript and TypeScript export usage by context",
  "type": "module",
  "bin": {
    "smella": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/nx-react.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "smella-linux-x64-gnu": "0.1.0"
  },
  "scripts": {
    "build:native": "node scripts/build.mjs --release",
    "build:ts": "tsdown",
    "build": "node scripts/build.mjs --release && tsdown",
    "typecheck": "tsc --noEmit",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test",
    "test": "node scripts/build.mjs && tsdown && node --test test/*.test.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "bench:record": "npm run build && node scripts/track-bench.mjs --record --check",
    "verify:corpus": "npm run build && node scripts/verify-corpus.mjs",
    "bench:check": "npm run build && node scripts/track-bench.mjs --check",
    "bench:plot": "node scripts/plot-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
