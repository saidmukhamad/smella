{
  "name": "smella",
  "version": "0.1.0",
  "private": true,
  "description": "Explain JavaScript and TypeScript export usage by context",
  "type": "module",
  "bin": { "smella": "./bin/smella.mjs" },
  "exports": { ".": { "types": "./index.d.ts", "default": "./index.js" } },
  "files": ["bin", "index.js", "index.d.ts", "README.md", "docs/nx-react.md"],
  "engines": { "node": ">=22" },
  "optionalDependencies": { "smella-linux-x64-gnu": "0.1.0" },
  "scripts": {
    "build": "node scripts/build.mjs --release",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "check": "npm run fmt:check && npm run lint && npm test",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "bench": "node scripts/build.mjs --release && node scripts/bench.mjs",
    "bench:record": "node scripts/build.mjs --release && node scripts/track-bench.mjs --record --check",
    "verify:corpus": "node scripts/build.mjs --release && node scripts/verify-corpus.mjs",
    "bench:check": "node scripts/build.mjs --release && node scripts/track-bench.mjs --check",
    "bench:plot": "node scripts/plot-bench.mjs"
  }
}
